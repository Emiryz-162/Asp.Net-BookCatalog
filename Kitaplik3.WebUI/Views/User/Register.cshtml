@using Kitaplik3.DTOs.UserDTOs
@model UserRegisterDto
@{
    ViewData["Title"] = "Kayıt Ol";
}

<style>
    /* Register Container */
    .register-container {
        max-width: 500px;
        margin: 3rem auto;
    }

    /* Register Card */
    .register-card {
        background: white;
        border-radius: 20px;
        padding: 3rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        border: 2px solid #e2e8f0;
        transition: all 0.3s ease;
    }

    body.dark-mode .register-card {
        background: #1e293b;
        border-color: #334155;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .register-card:hover {
        box-shadow: 0 15px 40px rgba(102, 126, 234, 0.2);
        border-color: #667eea;
    }

    body.dark-mode .register-card:hover {
        box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
        border-color: #7c3aed;
    }

    /* Header */
    .register-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .register-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin: 0 auto 1.5rem;
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
        animation: float 3s ease-in-out infinite;
    }

    body.dark-mode .register-icon {
        background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
        box-shadow: 0 8px 20px rgba(124, 58, 237, 0.5);
    }

    @@keyframes float {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }

    }

    .register-title {
        font-size: 2rem;
        font-weight: 800;
        color: #2d3748;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    body.dark-mode .register-title {
        background: linear-gradient(135deg, #a78bfa 0%, #c084fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .register-subtitle {
        color: #718096;
        font-size: 1rem;
    }

    body.dark-mode .register-subtitle {
        color: #94a3b8;
    }

    /* Form Groups */
    .form-group-custom {
        margin-bottom: 1.5rem;
        position: relative;
    }

    .form-row-custom {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    /* Labels */
    .form-label-custom {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.5rem;
        display: block;
        font-size: 0.95rem;
    }

    body.dark-mode .form-label-custom {
        color: #e2e8f0;
    }

    .label-icon {
        margin-right: 0.5rem;
    }

    /* Inputs */
    .form-control-custom {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: #f7fafc;
    }

    body.dark-mode .form-control-custom {
        background: #0f172a;
        border-color: #334155;
        color: #e2e8f0;
    }

    .form-control-custom:focus {
        outline: none;
        border-color: #667eea;
        background: white;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
    }

    body.dark-mode .form-control-custom:focus {
        background: #1e293b;
        border-color: #7c3aed;
        box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.2);
    }

    .form-control-custom:hover {
        border-color: #cbd5e0;
    }

    body.dark-mode .form-control-custom:hover {
        border-color: #475569;
    }

    /* Password Input Wrapper */
    .password-input-wrapper {
        position: relative;
    }

    .password-toggle-btn {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #718096;
        font-size: 1.2rem;
        padding: 0.5rem;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    body.dark-mode .password-toggle-btn {
        color: #94a3b8;
    }

    .password-toggle-btn:hover {
        color: #667eea;
        background: rgba(102, 126, 234, 0.1);
    }

    body.dark-mode .password-toggle-btn:hover {
        color: #a78bfa;
        background: rgba(167, 139, 250, 0.1);
    }

    /* Validation Messages - DÜZELTME */
    .validation-message {
        color: #e53e3e;
        font-size: 0.875rem;
        margin-top: 0.5rem;
        display: none;
        align-items: center;
        gap: 0.5rem;
        background: #fff5f5;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        border-left: 3px solid #e53e3e;
    }

    body.dark-mode .validation-message {
        color: #fca5a5;
        background: rgba(220, 38, 38, 0.1);
        border-left-color: #dc2626;
    }

    .validation-message:not(:empty) {
        display: flex;
    }

    .field-validation-error {
        color: #e53e3e;
        font-size: 0.875rem;
        margin-top: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: #fff5f5;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        border-left: 3px solid #e53e3e;
    }

    body.dark-mode .field-validation-error {
        color: #fca5a5;
        background: rgba(220, 38, 38, 0.1);
        border-left-color: #dc2626;
    }

    .field-validation-valid {
        display: none !important;
    }

    .input-validation-error {
        border-color: #e53e3e !important;
        background: #fff5f5 !important;
    }

    body.dark-mode .input-validation-error {
        border-color: #dc2626 !important;
        background: rgba(220, 38, 38, 0.1) !important;
    }

    /* Submit Button */
    .btn-submit-custom {
        width: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1rem;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

    body.dark-mode .btn-submit-custom {
        background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
        box-shadow: 0 4px 15px rgba(124, 58, 237, 0.5);
    }

    .btn-submit-custom:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }

    body.dark-mode .btn-submit-custom:hover {
        box-shadow: 0 8px 25px rgba(124, 58, 237, 0.6);
    }

    .btn-submit-custom:active {
        transform: translateY(-1px);
    }

    /* Divider */
    .divider {
        border-top: 2px solid #e2e8f0;
        margin: 2rem 0 1.5rem;
    }

    body.dark-mode .divider {
        border-top-color: #334155;
    }

    /* Login Link */
    .login-link-section {
        text-align: center;
    }

    .login-text {
        color: #718096;
        margin-bottom: 0.75rem;
        font-size: 0.95rem;
    }

    body.dark-mode .login-text {
        color: #94a3b8;
    }

    .login-link {
        display: inline-block;
        color: #667eea;
        text-decoration: none;
        font-weight: 600;
        padding: 0.75rem 2rem;
        border-radius: 10px;
        transition: all 0.3s ease;
        border: 2px solid #667eea;
    }

    body.dark-mode .login-link {
        color: #a78bfa;
        border-color: #7c3aed;
    }

    .login-link:hover {
        background: #667eea;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    body.dark-mode .login-link:hover {
        background: #7c3aed;
        color: white;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.5);
    }

    /* Password Strength Indicator */
    .password-strength {
        margin-top: 0.5rem;
        height: 4px;
        background: #e2e8f0;
        border-radius: 4px;
        overflow: hidden;
        display: none;
    }

    body.dark-mode .password-strength {
        background: #334155;
    }

    .password-strength-bar {
        height: 100%;
        width: 0;
        transition: all 0.3s ease;
        border-radius: 4px;
    }

    .password-strength.weak .password-strength-bar {
        width: 33%;
        background: #f56565;
    }

    body.dark-mode .password-strength.weak .password-strength-bar {
        background: #dc2626;
    }

    .password-strength.medium .password-strength-bar {
        width: 66%;
        background: #ed8936;
    }

    body.dark-mode .password-strength.medium .password-strength-bar {
        background: #f97316;
    }

    .password-strength.strong .password-strength-bar {
        width: 100%;
        background: #48bb78;
    }

    body.dark-mode .password-strength.strong .password-strength-bar {
        background: #10b981;
    }

    /* Responsive */
    @@media (max-width: 576px) {
        .register-container

    {
        margin: 1.5rem auto;
        padding: 0 1rem;
    }

    .register-card {
        padding: 2rem 1.5rem;
    }

    .form-row-custom {
        grid-template-columns: 1fr;
    }

    .register-title {
        font-size: 1.75rem;
    }

    .register-icon {
        width: 70px;
        height: 70px;
        font-size: 2rem;
    }

    }
</style>

<div class="register-container">
    <div class="register-card">
        <!-- Header -->
        <div class="register-header">
            <div class="register-icon">
                ✨
            </div>
            <h1 class="register-title">Hesap Oluştur</h1>
            <p class="register-subtitle">Kitaplık ailesine katılın</p>
        </div>

        <!-- Form -->
        <form asp-action="Register" asp-controller="User" method="post">
            <!-- Name & Surname Row -->
            <div class="form-row-custom">
                <div class="form-group-custom">
                    <label class="form-label-custom">
                        <span class="label-icon">👤</span>
                        Adınız
                    </label>
                    <input type="text"
                           class="form-control-custom"
                           asp-for="Name"
                           placeholder="Örn: Ahmet">
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>

                <div class="form-group-custom">
                    <label class="form-label-custom">
                        <span class="label-icon">👤</span>
                        Soyadınız
                    </label>
                    <input type="text"
                           class="form-control-custom"
                           asp-for="Surname"
                           placeholder="Örn: Yılmaz">
                    <span asp-validation-for="Surname" class="field-validation-error"></span>
                </div>
            </div>

            <!-- Email -->
            <div class="form-group-custom">
                <label class="form-label-custom">
                    <span class="label-icon">📧</span>
                    Email Adresiniz
                </label>
                <input type="email"
                       class="form-control-custom"
                       asp-for="Email"
                       placeholder="ornek@email.com">
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <!-- Password -->
            <div class="form-group-custom">
                <label class="form-label-custom">
                    <span class="label-icon">🔒</span>
                    Şifre Oluşturun
                </label>
                <div class="password-input-wrapper">
                    <input type="password"
                           class="form-control-custom"
                           asp-for="Password"
                           id="passwordInput"
                           placeholder="••••••••">
                    <button type="button"
                            class="password-toggle-btn"
                            id="passwordToggle"
                            aria-label="Şifreyi göster/gizle">
                        <span id="toggleIcon">👁️</span>
                    </button>
                </div>
                <div class="password-strength" id="passwordStrength">
                    <div class="password-strength-bar"></div>
                </div>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-submit-custom">
                🚀 Hesabı Oluştur
            </button>
        </form>

        <!-- Divider -->
        <div class="divider"></div>

        <!-- Login Link -->
        <div class="login-link-section">
            <p class="login-text">Zaten hesabınız var mı?</p>
            <a asp-action="Login" asp-controller="User" class="login-link">
                🔐 Giriş Yap
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Password Toggle
        document.getElementById('passwordToggle').addEventListener('click', function() {
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.textContent = '🙈';
            } else {
                passwordInput.type = 'password';
                toggleIcon.textContent = '👁️';
            }
        });

        // Password Strength Indicator
        document.getElementById('passwordInput').addEventListener('input', function() {
            const password = this.value;
            const strengthIndicator = document.getElementById('passwordStrength');

            if (password.length === 0) {
                strengthIndicator.style.display = 'none';
                strengthIndicator.className = 'password-strength';
                return;
            }

            strengthIndicator.style.display = 'block';

            let strength = 0;
            if (password.length >= 8) strength++;
            if (/[A-Z]/.test(password)) strength++;
            if (/[a-z]/.test(password)) strength++;
            if (/[0-9]/.test(password)) strength++;

            strengthIndicator.className = 'password-strength';
            if (strength <= 2) {
                strengthIndicator.classList.add('weak');
            } else if (strength === 3) {
                strengthIndicator.classList.add('medium');
            } else {
                strengthIndicator.classList.add('strong');
            }
        });
    </script>
}