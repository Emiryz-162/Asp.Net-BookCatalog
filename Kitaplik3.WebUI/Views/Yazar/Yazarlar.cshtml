@model Author

<style>
    /* Sayfa Başlığı */
    .page-header {
        background: linear-gradient(135deg, #4fd1c5 0%, #38b2ac 100%);
        color: white;
        padding: 2rem;
        border-radius: 15px;
        margin-bottom: 2rem;
        box-shadow: 0 8px 16px rgba(56, 178, 172, 0.3);
        transition: all 0.3s ease;
    }

    body.dark-mode .page-header {
        background: linear-gradient(135deg, #0d9488 0%, #115e59 100%);
        box-shadow: 0 8px 16px rgba(13, 148, 136, 0.5);
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
    }

    .page-subtitle {
        opacity: 0.9;
        margin-top: 0.5rem;
    }

    /* İki Panelli Layout */
    .content-wrapper {
        display: grid;
        grid-template-columns: 1fr 400px;
        gap: 2rem;
    }

    /* Liste Paneli */
    .list-panel {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border: 2px solid #e2e8f0;
        transition: all 0.3s ease;
    }

    body.dark-mode .list-panel {
        background: #1e293b;
        border-color: #334155;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
    }

    .panel-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: color 0.3s ease;
    }

    body.dark-mode .panel-title {
        color: #e2e8f0;
    }

    /* Yazar Kartları */
    .author-card {
        background: linear-gradient(135deg, #e6fffa 0%, #b2f5ea 100%);
        border: 2px solid #81e6d9;
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    body.dark-mode .author-card {
        background: linear-gradient(135deg, rgba(13, 148, 136, 0.1) 0%, rgba(17, 94, 89, 0.2) 100%);
        border-color: #0d9488;
    }

    .author-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(56, 178, 172, 0.3);
        border-color: #38b2ac;
    }

    body.dark-mode .author-card:hover {
        box-shadow: 0 8px 16px rgba(13, 148, 136, 0.5);
        border-color: #14b8a6;
    }

    .author-card.editing {
        border-color: #667eea;
        background: linear-gradient(135deg, #e6f2ff 0%, #c3dafe 100%);
    }

    body.dark-mode .author-card.editing {
        border-color: #7c3aed;
        background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(124, 58, 237, 0.2) 100%);
    }

    .author-info {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .author-id {
        background: linear-gradient(135deg, #4fd1c5 0%, #38b2ac 100%);
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.1rem;
        transition: all 0.3s ease;
    }

    body.dark-mode .author-id {
        background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
    }

    .author-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2d3748;
        margin: 0;
        transition: color 0.3s ease;
    }

    body.dark-mode .author-name {
        color: #e2e8f0;
    }

    .author-actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-edit-mini {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

    body.dark-mode .btn-edit-mini {
        background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
    }

    .btn-edit-mini:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(102, 126, 234, 0.4);
    }

    body.dark-mode .btn-edit-mini:hover {
        box-shadow: 0 4px 8px rgba(124, 58, 237, 0.6);
    }

    .btn-delete-mini {
        background: linear-gradient(135deg, #fc8181 0%, #f56565 100%);
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

    body.dark-mode .btn-delete-mini {
        background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
    }

    .btn-delete-mini:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(245, 101, 101, 0.4);
    }

    body.dark-mode .btn-delete-mini:hover {
        box-shadow: 0 4px 8px rgba(220, 38, 38, 0.6);
    }

    /* Form Paneli */
    .form-panel {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border: 2px solid #e2e8f0;
        position: sticky;
        top: 2rem;
        height: fit-content;
        transition: all 0.3s ease;
    }

    body.dark-mode .form-panel {
        background: #1e293b;
        border-color: #334155;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
    }

    .form-panel.edit-mode {
        border-color: #667eea;
        box-shadow: 0 8px 16px rgba(102, 126, 234, 0.3);
    }

    body.dark-mode .form-panel.edit-mode {
        border-color: #7c3aed;
        box-shadow: 0 8px 16px rgba(124, 58, 237, 0.5);
    }

    .form-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #4fd1c5 0%, #38b2ac 100%);
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 1rem;
        transition: all 0.3s ease;
    }

    body.dark-mode .form-icon {
        background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
    }

    .form-icon.edit-mode {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    body.dark-mode .form-icon.edit-mode {
        background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
    }

    .form-mode-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        transition: all 0.3s ease;
    }

    .badge-add {
        background: #b2f5ea;
        color: #234e52;
    }

    body.dark-mode .badge-add {
        background: rgba(20, 184, 166, 0.3);
        color: #5eead4;
    }

    .badge-edit {
        background: #c3dafe;
        color: #2c5282;
    }

    body.dark-mode .badge-edit {
        background: rgba(124, 58, 237, 0.3);
        color: #c084fc;
    }

    /* Form Elemanları */
    .form-group-custom {
        margin-bottom: 1.5rem;
    }

    .form-label-custom {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.5rem;
        display: block;
        font-size: 0.95rem;
        transition: color 0.3s ease;
    }

    body.dark-mode .form-label-custom {
        color: #e2e8f0;
    }

    .form-control-custom {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: #f7fafc;
    }

    body.dark-mode .form-control-custom {
        background: #0f172a;
        border-color: #334155;
        color: #e2e8f0;
    }

    .form-control-custom:focus {
        outline: none;
        border-color: #38b2ac;
        background: white;
        box-shadow: 0 0 0 3px rgba(56, 178, 172, 0.1);
    }

    body.dark-mode .form-control-custom:focus {
        background: #1e293b;
        border-color: #14b8a6;
        box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.2);
    }

    .form-control-custom.edit-mode:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    body.dark-mode .form-control-custom.edit-mode:focus {
        border-color: #7c3aed;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.2);
    }

    .validation-message {
        color: #e53e3e;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    body.dark-mode .validation-message {
        color: #fca5a5;
    }

    .btn-submit {
        background: linear-gradient(135deg, #4fd1c5 0%, #38b2ac 100%);
        color: white;
        border: none;
        padding: 0.875rem 2rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        cursor: pointer;
        width: 100%;
    }

    body.dark-mode .btn-submit {
        background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
    }

    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(56, 178, 172, 0.4);
    }

    body.dark-mode .btn-submit:hover {
        box-shadow: 0 8px 16px rgba(20, 184, 166, 0.6);
    }

    .btn-submit.edit-mode {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    body.dark-mode .btn-submit.edit-mode {
        background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
    }

    .btn-submit.edit-mode:hover {
        box-shadow: 0 8px 16px rgba(102, 126, 234, 0.4);
    }

    body.dark-mode .btn-submit.edit-mode:hover {
        box-shadow: 0 8px 16px rgba(124, 58, 237, 0.6);
    }

    .btn-cancel {
        background: #e2e8f0;
        color: #4a5568;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 10px;
        font-weight: 500;
        cursor: pointer;
        width: 100%;
        margin-top: 0.5rem;
        transition: all 0.3s ease;
        display: none;
    }

    body.dark-mode .btn-cancel {
        background: #334155;
        color: #cbd5e1;
    }

    .btn-cancel.show {
        display: block;
    }

    .btn-cancel:hover {
        background: #cbd5e0;
    }

    body.dark-mode .btn-cancel:hover {
        background: #475569;
        color: #e2e8f0;
    }

    /* Boş Durum */
    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        color: #718096;
        transition: color 0.3s ease;
    }

    body.dark-mode .empty-state {
        color: #94a3b8;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    /* Bilgi Kutusu */
    .info-box {
        margin-top: 1.5rem;
        padding: 1rem;
        background: #e6fffa;
        border-radius: 10px;
        border-left: 4px solid #38b2ac;
        transition: all 0.3s ease;
    }

    body.dark-mode .info-box {
        background: rgba(20, 184, 166, 0.1);
        border-left-color: #14b8a6;
    }

    .info-box p {
        margin: 0;
        font-size: 0.9rem;
        color: #4a5568;
        transition: color 0.3s ease;
    }

    body.dark-mode .info-box p {
        color: #cbd5e1;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .content-wrapper

    {
        grid-template-columns: 1fr;
    }

    .form-panel {
        position: static;
    }

    }
</style>
<br />
<div class="container">
    <!-- Sayfa Başlığı -->
    <div class="page-header">
        <h1 class="page-title">✍️ Yazar Yönetimi</h1>
        <p class="page-subtitle mb-0">
            Yazarları görüntüleyin, ekleyin ve düzenleyin
        </p>
    </div>

    <!-- İki Panelli İçerik -->
    <div class="content-wrapper">
        <!-- Sol Panel: Yazar Listesi -->
        <div class="list-panel">
            <h2 class="panel-title">
                📋 Tüm Yazarlar
                <span style="font-size: 1rem; color: #718096; font-weight: 400;">
                    (@ViewBag.YazarlarBag.Count adet)
                </span>
            </h2>

            @if (ViewBag.YazarlarBag.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">✍️</div>
                    <p style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem;">
                        Henüz yazar eklenmemiş
                    </p>
                    <p>Sağ taraftaki formu kullanarak ilk yazarı ekleyin</p>
                </div>
            }
            else
            {
                @foreach (var item in ViewBag.YazarlarBag)
                {
                    <div class="author-card" id="author-@item.Id">
                        <div class="author-info">
                            <div class="author-id">@item.Id</div>
                            <h3 class="author-name">@item.Name</h3>
                        </div>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="author-actions">
                                <button type="button" class="btn-edit-mini" onclick="editAuthor(@item.Id, '@item.Name')">
                                    ✏️ Düzenle
                                </button>
                                <form asp-controller="Yazar" asp-action="Sil" method="post" class="d-inline"
                                      onsubmit="return confirm('[@item.Name] yazarını silmek istediğinize emin misiniz?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-delete-mini">
                                        🗑️ Sil
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <!-- Sağ Panel: Ekleme/Güncelleme Formu -->
        <div class="form-panel" id="formPanel">
            <div class="text-center">
                <span class="form-mode-badge badge-add" id="modeBadge">EKLEME MODU</span>
            </div>

            <div class="form-icon" id="formIcon">
                <span id="iconText">➕</span>
            </div>

            <h2 class="panel-title" style="text-align: center; font-size: 1.3rem;" id="formTitle">
                Yeni Yazar Ekle
            </h2>

            <form asp-action="YazarEkle" asp-controller="Yazar" method="post" id="authorForm">
                <input type="hidden" id="authorId" name="Id" value="0" />

                <div class="form-group-custom">
                    <label class="form-label-custom">
                        ✍️ Yazar Adı
                    </label>
                    <input type="text"
                           class="form-control-custom"
                           id="authorName"
                           asp-for="Name"
                           placeholder="Örn: Orhan Pamuk, Fyodor Dostoyevski...">
                    <span asp-validation-for="Name" class="validation-message"></span>
                </div>

                <button type="submit" class="btn-submit" id="submitBtn">
                    <span id="submitText">✅ Yazar Ekle</span>
                </button>

                <button type="button" class="btn-cancel" id="cancelBtn" onclick="cancelEdit()">
                    ❌ İptal
                </button>
            </form>

            <!-- Bilgi Kutusu -->
            <div class="info-box">
                <p>
                    <strong>💡 İpucu:</strong> Yazar adı en az 3 karakter olmalıdır.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Düzenleme Modu
        function editAuthor(id, name) {
            document.getElementById('authorForm').action = '/Yazar/Guncelle';
            document.getElementById('authorId').value = id;
            document.getElementById('authorName').value = name;

            document.getElementById('formPanel').classList.add('edit-mode');
            document.getElementById('formIcon').classList.add('edit-mode');
            document.getElementById('iconText').textContent = '✏️';
            document.getElementById('formTitle').textContent = 'Yazar Güncelle';
            document.getElementById('modeBadge').textContent = 'GÜNCELLEME MODU';
            document.getElementById('modeBadge').classList.remove('badge-add');
            document.getElementById('modeBadge').classList.add('badge-edit');
            document.getElementById('submitBtn').classList.add('edit-mode');
            document.getElementById('submitText').textContent = '💾 Güncelle';
            document.getElementById('cancelBtn').classList.add('show');
            document.getElementById('authorName').classList.add('edit-mode');

            document.querySelectorAll('.author-card').forEach(card => {
                card.classList.remove('editing');
            });
            document.getElementById('author-' + id).classList.add('editing');

            document.getElementById('authorName').focus();
            document.getElementById('formPanel').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        // İptal Et
        function cancelEdit() {
            document.getElementById('authorForm').action = '/Yazar/YazarEkle';
            document.getElementById('authorId').value = '0';
            document.getElementById('authorName').value = '';

            document.getElementById('formPanel').classList.remove('edit-mode');
            document.getElementById('formIcon').classList.remove('edit-mode');
            document.getElementById('iconText').textContent = '➕';
            document.getElementById('formTitle').textContent = 'Yeni Yazar Ekle';
            document.getElementById('modeBadge').textContent = 'EKLEME MODU';
            document.getElementById('modeBadge').classList.remove('badge-edit');
            document.getElementById('modeBadge').classList.add('badge-add');
            document.getElementById('submitBtn').classList.remove('edit-mode');
            document.getElementById('submitText').textContent = '✅ Yazar Ekle';
            document.getElementById('cancelBtn').classList.remove('show');
            document.getElementById('authorName').classList.remove('edit-mode');

            document.querySelectorAll('.author-card').forEach(card => {
                card.classList.remove('editing');
            });
        }
    </script>
}